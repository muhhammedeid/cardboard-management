 "doc_type": "Cardboard Supply",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 10,
 "html": "<style>\n@page { size: A5 portrait; margin: 8mm; }\n.cardboard-supply-ticket { color: #1f2933; direction: rtl; font-family: \"Noto Naskh Arabic\", Tahoma, Arial, sans-serif; font-size: 10pt; line-height: 1.35; margin: 0 auto; max-width: 148mm; }\n.cardboard-supply-ticket * { box-sizing: border-box; }\n.ticket-header { border-bottom: 2px solid #243b53; display: table; padding-bottom: 4mm; width: 100%; }\n.ticket-logo, .ticket-heading { display: table-cell; vertical-align: middle; }\n.ticket-logo { padding-left: 4mm; width: 25mm; }\n.ticket-logo img { max-height: 20mm; max-width: 22mm; object-fit: contain; }\n.ticket-heading { text-align: center; }\n.company-name, .ticket-title { font-weight: 700; margin: 0; }\n.company-name { font-size: 14pt; }\n.ticket-title { font-size: 17pt; margin-top: 1mm; }\n.ticket-subtitle, .label-en, .unit { color: #627d98; direction: ltr; font-family: Arial, sans-serif; font-size: 7.5pt; }\n.ticket-section { margin-top: 4mm; }\n.section-title { background: #eaf0f6; border-right: 4px solid #243b53; font-size: 11pt; margin: 0 0 2mm; padding: 1.5mm 2mm; }\n.ticket-table { border-collapse: collapse; width: 100%; }\n.ticket-table th, .ticket-table td { border-bottom: 1px solid #d9e2ec; padding: 1.8mm 2mm; }\n.ticket-table th { font-weight: 600; text-align: right; width: 58%; }\n.ticket-table td { direction: ltr; font-family: Arial, sans-serif; text-align: left; }\n.label-en { display: block; margin-top: .2mm; }\n.unit { font-size: 8pt; }\n.total-panel { background: #f0f7ff; border: 1.5px solid #243b53; margin-top: 3mm; padding: 3mm; text-align: center; }\n.total-label { font-size: 10pt; font-weight: 700; }\n.total-value { direction: ltr; font-family: Arial, sans-serif; font-size: 23pt; font-weight: 700; line-height: 1.1; margin-top: 1mm; }\n.payment-reference { color: #486581; direction: ltr; font-family: Arial, sans-serif; font-size: 8pt; margin: 0 0 1.5mm; }\n.integration-notice { background: #fff8e6; border: 1px solid #d9a441; padding: 3mm; text-align: center; }\n.ticket-signatures { display: table; margin-top: 8mm; width: 100%; }\n.signature { display: table-cell; padding: 0 3mm; text-align: center; width: 50%; }\n.signature-line { border-top: 1px solid #627d98; margin: 12mm auto 1.5mm; width: 85%; }\n.signature-label { font-weight: 600; }\n@media print { .cardboard-supply-ticket { max-width: none; } }\n</style>\n\n<div class=\"cardboard-supply-ticket\" dir=\"rtl\" lang=\"ar\">\n\t<header class=\"ticket-header\">\n\t\t{% if doc.ticket_company_logo %}<div class=\"ticket-logo\"><img src=\"{{ doc.ticket_company_logo | e }}\" alt=\"{{ doc.ticket_company_name | e }}\"></div>{% endif %}\n\t\t<div class=\"ticket-heading\">\n\t\t\t<p class=\"company-name\">{{ doc.ticket_company_name | e }}</p>\n\t\t\t<p class=\"ticket-title\">كارتة استلام توريدة</p>\n\t\t\t<p class=\"ticket-subtitle\">Cardboard Supply Ticket</p>\n\t\t</div>\n\t</header>\n\n\t<section class=\"ticket-section\">\n\t\t<table class=\"ticket-table\"><tbody>\n\t\t\t<tr><th>رقم التوريدة<span class=\"label-en\">Supply No.</span></th><td data-ticket-field=\"supply_number\">{{ doc.name | e }}</td></tr>\n\t\t\t<tr><th>تاريخ التوريد<span class=\"label-en\">Posting Date</span></th><td data-ticket-field=\"posting_date\">{{ doc.get_formatted(\"posting_date\") }}</td></tr>\n\t\t\t<tr><th>المورد<span class=\"label-en\">Supplier</span></th><td data-ticket-field=\"supplier\">{{ doc.ticket_supplier_name | e }}</td></tr>\n\t\t\t<tr><th>نوع الكرتون<span class=\"label-en\">Cardboard Type</span></th><td data-ticket-field=\"item\">{{ doc.ticket_item_name | e }}</td></tr>\n\t\t\t<tr><th>رقم السيارة<span class=\"label-en\">Vehicle No.</span></th><td data-ticket-field=\"vehicle_no\">{{ (doc.vehicle_no or \"—\") | e }}</td></tr>\n\t\t\t<tr><th>اسم السائق<span class=\"label-en\">Driver Name</span></th><td data-ticket-field=\"driver_name\">{{ (doc.driver_name or \"—\") | e }}</td></tr>\n\t\t</tbody></table>\n\t</section>\n\n\t<section class=\"ticket-section\">\n\t\t<h2 class=\"section-title\">الأوزان <span class=\"label-en\">Weights</span></h2>\n\t\t<table class=\"ticket-table\"><tbody>\n\t\t\t<tr><th>الوزن القائم<span class=\"label-en\">Gross Weight</span></th><td data-ticket-field=\"gross_weight\">{{ doc.get_formatted(\"gross_weight\") }} <span class=\"unit\">{{ doc.ticket_weight_uom | e }}</span></td></tr>\n\t\t\t<tr><th>وزن السيارة<span class=\"label-en\">Tare Weight</span></th><td data-ticket-field=\"tare_weight\">{{ doc.get_formatted(\"tare_weight\") }} <span class=\"unit\">{{ doc.ticket_weight_uom | e }}</span></td></tr>\n\t\t\t<tr><th>الوزن الصافي<span class=\"label-en\">Physical Net Weight</span></th><td data-ticket-field=\"net_weight\">{{ doc.get_formatted(\"net_weight\") }} <span class=\"unit\">{{ doc.ticket_weight_uom | e }}</span></td></tr>\n\t\t\t<tr><th>نوع الخصم<span class=\"label-en\">Discount Type</span></th><td data-ticket-field=\"discount_type\">{{ doc.discount_type | e }}</td></tr>\n\t\t\t<tr><th>قيمة الخصم<span class=\"label-en\">Discount Value</span></th><td data-ticket-field=\"discount_value\">{{ doc.get_formatted(\"discount_value\") }}{% if doc.discount_type == \"Percentage\" %}%{% elif doc.discount_type == \"Kg\" %} <span class=\"unit\">{{ doc.ticket_weight_uom | e }}</span>{% endif %}</td></tr>\n\t\t\t<tr><th>وزن الخصم<span class=\"label-en\">Discount Weight</span></th><td data-ticket-field=\"discount_weight\">{{ doc.get_formatted(\"discount_weight\") }} <span class=\"unit\">{{ doc.ticket_weight_uom | e }}</span></td></tr>\n\t\t\t<tr><th>الوزن المحتسب<span class=\"label-en\">Payable Weight</span></th><td data-ticket-field=\"payable_weight\">{{ doc.get_formatted(\"display_payable_weight\") }} <span class=\"unit\">{{ doc.ticket_weight_uom | e }}</span></td></tr>\n\t\t</tbody></table>\n\t</section>\n\n\t<section class=\"ticket-section\">\n\t\t<h2 class=\"section-title\">الحساب <span class=\"label-en\">Pricing</span></h2>\n\t\t<table class=\"ticket-table\"><tbody>\n\t\t\t<tr><th>سعر الكيلو<span class=\"label-en\">Agreed Rate per Kg</span></th><td data-ticket-field=\"rate_per_kg\">{{ doc.get_formatted(\"rate_per_kg\", currency=doc.ticket_currency) }} <span class=\"unit\">/ {{ doc.ticket_weight_uom | e }}</span></td></tr>\n\t\t\t<tr><th>العملة<span class=\"label-en\">Currency</span></th><td data-ticket-field=\"currency\">{{ doc.ticket_currency | e }}</td></tr>\n\t\t</tbody></table>\n\t\t<div class=\"total-panel\"><div class=\"total-label\">الإجمالي <span class=\"label-en\">Total Amount</span></div><div class=\"total-value\" data-ticket-field=\"total_amount\">{{ doc.get_formatted(\"total_amount\", currency=doc.ticket_currency) }}</div></div>\n\t</section>\n\n\t<section class=\"ticket-section\">\n\t\t<h2 class=\"section-title\">السداد <span class=\"label-en\">Payment</span></h2>\n\t\t{% if doc.integration_status == \"Integrated\" %}\n\t\t\t<p class=\"payment-reference\">Purchase Invoice: {{ doc.purchase_invoice | e }}</p>\n\t\t\t<table class=\"ticket-table\"><tbody>\n\t\t\t\t<tr><th>قيمة الفاتورة<span class=\"label-en\">Invoice Total</span></th><td data-ticket-field=\"invoice_total\">{{ doc.get_formatted(\"invoice_total\", currency=doc.ticket_currency) }}</td></tr>\n\t\t\t\t<tr><th>المدفوع<span class=\"label-en\">Paid Amount</span></th><td data-ticket-field=\"paid_amount\">{{ doc.get_formatted(\"invoice_paid_amount\", currency=doc.ticket_currency) }}</td></tr>\n\t\t\t\t<tr><th>المتبقي<span class=\"label-en\">Outstanding Amount</span></th><td data-ticket-field=\"outstanding_amount\">{{ doc.get_formatted(\"purchase_invoice_outstanding\", currency=doc.ticket_currency) }}</td></tr>\n\t\t\t\t<tr><th>حالة السداد<span class=\"label-en\">Payment Status</span></th><td data-ticket-field=\"payment_status\">{{ doc.payment_status | e }}</td></tr>\n\t\t\t</tbody></table>\n\t\t{% else %}\n\t\t\t<div class=\"integration-notice\" data-ticket-integration-state=\"{{ doc.integration_status | e }}\">\n\t\t\t\t{% if doc.integration_status == \"Invalid Link\" %}رابط فاتورة الشراء غير صالح <span class=\"label-en\">Invalid Purchase Invoice Link</span>{% else %}غير مرتبط <span class=\"label-en\">Not Integrated — No Purchase Invoice</span>{% endif %}\n\t\t\t</div>\n\t\t{% endif %}\n\t</section>\n\n\t<footer class=\"ticket-signatures\">\n\t\t<div class=\"signature\"><div class=\"signature-line\"></div><div class=\"signature-label\">توقيع المورد <span class=\"label-en\">Supplier Signature</span></div></div>\n\t\t<div class=\"signature\"><div class=\"signature-line\"></div><div class=\"signature-label\">توقيع المستلم <span class=\"label-en\">Receiver Signature</span></div></div>\n\t</footer>\n</div>",
 "line_breaks": 0,
 "margin_bottom": 8.0,
